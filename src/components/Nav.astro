---
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[color:var(--bg)]/70 border-b border-[color:var(--border)]">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2.5 group" aria-label="OpenConveyor home">
      <img src="/logo.svg" alt="" width="32" height="32" class="h-8 w-8" />
      <span class="text-[15px] font-semibold tracking-tight text-[color:var(--text)]">openconveyor</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-3">
      <a
        href="#how"
        class="hidden sm:inline-block px-3 py-2 text-sm text-[color:var(--text-muted)] hover:text-[color:var(--text)] transition-colors"
      >How it works</a>
      <a
        href="#security"
        class="hidden sm:inline-block px-3 py-2 text-sm text-[color:var(--text-muted)] hover:text-[color:var(--text)] transition-colors"
      >Security</a>
      <a
        href="https://github.com/openconveyor/openconveyor#readme"
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-block px-3 py-2 text-sm text-[color:var(--text-muted)] hover:text-[color:var(--text)] transition-colors"
      >Docs</a>
      <a
        href="https://github.com/openconveyor/openconveyor"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 rounded-md border border-[color:var(--border)] bg-[color:var(--surface)] px-3 py-1.5 text-sm font-medium text-[color:var(--text)] transition hover:border-[color:var(--accent)]/40 hover:text-[color:var(--accent)]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.57.1.78-.25.78-.55v-2.07c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.26 5.69.41.35.78 1.04.78 2.1v3.11c0 .3.21.66.79.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/></svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>
      <ThemeToggle />
    </div>
  </nav>
</header>
