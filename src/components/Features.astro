---
const features = [
  {
    title: "Trigger-agnostic",
    promise: "Kick off work from wherever it already lives.",
    body: "GitHub issues, Linear tickets, cron schedules, slash commands: point a webhook at the adapter or reconcile Tasks directly. No new dashboard to learn.",
    icon: `<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/>`,
  },
  {
    title: "Agent-agnostic",
    promise: "Any container that reads a prompt and exits.",
    body: "Claude Code, aider, your own wrapper: if it fits in an image, it runs. v0.2.0 ships three reference agents out of the box: an implementer that opens PRs, a reviewer that comments on diffs, and a reporter that posts read-only summaries.",
    icon: `<rect x="3" y="8" width="18" height="12" rx="2"/><path d="M7 8V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3"/><path d="M8 14h.01M16 14h.01"/>`,
  },
  {
    title: "Least privilege by default",
    promise: "The agent gets nothing you didn't hand it.",
    body: "Default-deny egress. Zero RBAC unless declared. Secrets project as read-only files, listed explicitly in the Task. No implicit permissions, ever.",
    icon: `<path d="M12 2L4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z"/><path d="M9 12l2 2 4-4"/>`,
  },
  {
    title: "Kubernetes-native",
    promise: "Runs on the cluster you already have.",
    body: "No cloud dependency, no control plane to host, no vendor lock-in. One operator, one CRD, restricted Pod Security Standards, garbage-collected Jobs.",
    icon: `<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>`,
  },
];
---

<section class="border-t border-[color:var(--border)]">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <div class="max-w-2xl">
      <p class="text-xs font-mono uppercase tracking-wider text-[color:var(--accent)]">What's in the box</p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-[color:var(--text)]">
        Four defaults that mean you can actually hand off the work.
      </h2>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {features.map((f) => (
        <article class="group relative rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 transition hover:border-[color:var(--accent)]/40">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-[color:var(--accent)]/10 text-[color:var(--accent)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon}></svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-[color:var(--text)]">{f.title}</h3>
              <p class="mt-1 text-[color:var(--text)] text-[15px]">{f.promise}</p>
              <p class="mt-2 text-sm text-[color:var(--text-muted)] leading-relaxed">{f.body}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
